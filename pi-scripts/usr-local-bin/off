#!/bin/bash

# passive-disable hook
[ -z "${PASSIVE:-}" ] && [ -f /tmp/passive_active ] && { sudo rm -f /tmp/passive_active 2>/dev/null; sudo pkill -f passive-loop 2>/dev/null; }

# Turn the screen "off" without powering down the Pi.
# Stops video services + kills omxplayers. Screen goes black; ssh still works.
sudo systemctl stop tvplayer.service 2>/dev/null
sudo systemctl stop bgstatic.service 2>/dev/null
sleep 0.3
sudo pkill -9 omxplayer 2>/dev/null
sudo pkill -9 omxplayer.bin 2>/dev/null
# Optional: tell GPU to power off display (works on most Pi displays)
vcgencmd display_power 0 >/dev/null 2>&1
echo "Screen off. (run 'on' to bring it back)"
