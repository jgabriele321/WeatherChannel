#!/bin/bash
# Background loop for passive mode.
# Cycles 7 static screens, 8.5 min each, ~1 hr per full cycle.
# Bails the moment /tmp/passive_active disappears (user input).

SCREENS=(signal atx ldn bats aqi holiday now)
SECONDS_PER=510   # 8.5 minutes

while [ -f /tmp/passive_active ]; do
    for screen in "${SCREENS[@]}"; do
        [ -f /tmp/passive_active ] || exit 0
        # Use the marker so the static CLI doesn't disable passive itself.
        PASSIVE=1 /usr/local/bin/static "$screen" >/dev/null 2>&1
        # Interruptible sleep: poll the flag every second
        for i in $(seq 1 "$SECONDS_PER"); do
            [ -f /tmp/passive_active ] || exit 0
            sleep 1
        done
    done
done
